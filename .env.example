OPENAI_API_KEY=
CHAT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REVIEWER_KEY=replace-with-a-long-random-secret
DATA_DIR=./data
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
